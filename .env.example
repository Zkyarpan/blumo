# Public application configuration
NEXT_PUBLIC_APP_NAME=Blumo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI provider
POLLINATIONS_API_KEY=
POLLINATIONS_TEXT_MODEL=openai

# Product email — Resend API (server-only, never NEXT_PUBLIC_)
# Create a "Blumo Product Emails" key at https://resend.com/api-keys
# Key must start with re_
RESEND_API_KEY=re_your_product_key_here

# Sender addresses — must use the verified domain: mail.arpankarki.com.np
RESEND_AUTH_FROM="Blumo <no-reply@mail.arpankarki.com.np>"
RESEND_TASKS_FROM="Blumo Tasks <tasks@mail.arpankarki.com.np>"
RESEND_PROGRESS_FROM="Blumo Progress <progress@mail.arpankarki.com.np>"
RESEND_SUPPORT_FROM="Blumo Support <support@mail.arpankarki.com.np>"

# Support reply destination (receives forwarded support messages)
RESEND_REPLY_TO=arpan.karki.work@gmail.com

# Vercel Cron authentication (server-only; generate at least 32 random characters)
CRON_SECRET=replace-with-a-random-production-secret

# Optional later integrations
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# SENTRY_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
